{
  "name": "AirGuard Agent - Human-Approved Alert Dispatcher",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "airguard-approved-alert",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000001",
      "name": "AirGuard Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "airguard-approved-alert"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.status }}",
              "operation": "equal",
              "value2": "APPROVED"
            }
          ],
          "number": [
            {
              "value1": "={{ $json.body.action_id }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "1a2b3c4d-0002-4000-8000-000000000002",
      "name": "Verify Human Approval Guard",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Format SMS and WhatsApp payloads with clinical context & safety rails\nconst input = $input.first().json.body;\n\nconst formattedMessage = `🛡️ [AirGuard Proactive Advisory]\\n` +\n  `Patient ID: ${input.user_id}\\n` +\n  `Recipient: ${input.recipient}\\n` +\n  `Channel: ${input.channel.toUpperCase()}\\n\\n` +\n  `📋 Advisory:\\n${input.message}\\n\\n` +\n  `💡 Clinical Rationale:\\n${input.reasoning}\\n\\n` +\n  `⚠️ Non-diagnostic notification. In case of acute distress, call 112/108 or use your prescribed rescue inhaler.`;\n\nreturn [{\n  json: {\n    action_id: input.action_id,\n    user_id: input.user_id,\n    recipient: input.recipient,\n    channel: input.channel,\n    formatted_text: formattedMessage,\n    simulated_gateway: input.channel === 'sms' ? 'Twilio_SMS_Gateway' : 'WhatsApp_Cloud_API',\n    dispatched_timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "1a2b3c4d-0003-4000-8000-000000000003",
      "name": "Format Caregiver Alert Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"status\": \"DISPATCHED\",\n  \"workflow\": \"AirGuard-n8n-Caregiver-Relay\",\n  \"action_id\": {{ $json.action_id }},\n  \"gateway\": \"{{ $json.simulated_gateway }}\",\n  \"dispatched_at\": \"{{ $json.dispatched_timestamp }}\",\n  \"recipient\": \"{{ $json.recipient }}\",\n  \"preview\": \"{{ $json.formatted_text.slice(0, 100).replace(/\\n/g, ' ') }}...\"\n}",
        "options": {}
      },
      "id": "1a2b3c4d-0004-4000-8000-000000000004",
      "name": "Respond Approved to AirGuard",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        960,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"Security Guard Violation: Action was not approved by human patient\",\n  \"status\": \"REJECTED_BY_N8N_GUARD\",\n  \"blocked_at\": new Date().toISOString()\n}",
        "options": {
          "responseCode": 403
        }
      },
      "id": "1a2b3c4d-0005-4000-8000-000000000005",
      "name": "Block Unapproved Action",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        420
      ]
    }
  ],
  "connections": {
    "AirGuard Webhook Trigger": {
      "main": [
        [
          {
            "node": "Verify Human Approval Guard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Human Approval Guard": {
      "main": [
        [
          {
            "node": "Format Caregiver Alert Payload",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Block Unapproved Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Caregiver Alert Payload": {
      "main": [
        [
          {
            "node": "Respond Approved to AirGuard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
