# AirGuard Agent Environment Configuration Example
# Copy this file to .env and customize for your deployment

# Server Port (HuggingFace Spaces & local default: 7860)
PORT=7860
HOST=0.0.0.0
FLASK_ENV=production
SECRET_KEY=airguard-super-secret-production-key-replace-me

# SQLite / Database URI
DATABASE_URL=sqlite:///asthmai.db

# LLM Provider Configuration
# Supported providers: MOCK (default offline clinical heuristic engine), GEMINI, ANTHROPIC, OPENAI
LLM_PROVIDER=MOCK

# Optional External API Keys (Required only if LLM_PROVIDER is set to the respective service)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# n8n Automation Webhook URL (For approved notification dispatch & external integrations)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/airguard-approved-alert
