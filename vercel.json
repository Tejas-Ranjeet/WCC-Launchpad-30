{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://wcc-launchpad-30.onrender.com/api/:path*"
    },
    {
      "source": "/predict",
      "destination": "https://wcc-launchpad-30.onrender.com/predict"
    },
    {
      "source": "/save-profile",
      "destination": "https://wcc-launchpad-30.onrender.com/save-profile"
    },
    {
      "source": "/upload-sensor-data",
      "destination": "https://wcc-launchpad-30.onrender.com/upload-sensor-data"
    },
    {
      "source": "/figures/:path*",
      "destination": "https://wcc-launchpad-30.onrender.com/figures/:path*"
    },
    {
      "source": "/web_ui/:path*",
      "destination": "/web_ui/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
